# Copy this file to .env for local development. Never commit .env.

# Environment
AGRIMIND_ENV=development
AGRIMIND_LOG_LEVEL=INFO

# Device identity (non-secret UUIDs assigned during provisioning)
AGRIMIND_FARM_ID=00000000-0000-0000-0000-000000000000
AGRIMIND_DEVICE_ID=00000000-0000-0000-0000-000000000000

# MQTT cloud connection. Store real credentials only in .env or the runtime
# secret store. TLS verification must remain enabled outside explicit tests.
AGRIMIND_MQTT_HOST=mqtt.example.invalid
AGRIMIND_MQTT_PORT=8883
AGRIMIND_MQTT_USERNAME=replace-at-deployment
AGRIMIND_MQTT_PASSWORD=replace-at-deployment
AGRIMIND_MQTT_TLS_ENABLED=true
AGRIMIND_MQTT_CA_FILE=/etc/agrimind/certs/ca.pem
AGRIMIND_TELEMETRY_INTERVAL_SECONDS=5
AGRIMIND_CONTRACT_VERSION=v1

# Local Mosquitto fallback (explicit demo/LAN mode only)
AGRIMIND_LOCAL_MQTT_HOST=127.0.0.1
AGRIMIND_LOCAL_MQTT_PORT=1883

# Supabase public mobile configuration. The service_role key is intentionally
# absent: it is forbidden in Flutter and on the Raspberry Pi.
AGRIMIND_SUPABASE_URL=https://project-ref.supabase.co
AGRIMIND_SUPABASE_ANON_KEY=replace-with-public-anon-key

# Safe physical defaults. GPIO values reflect the verified NexusGuard wiring.
AGRIMIND_GPIO_DHT22=17
AGRIMIND_GPIO_RELAY=18
AGRIMIND_RELAY_ACTIVE_LOW=true
AGRIMIND_GPIO_ULTRASONIC_TRIGGER=23
AGRIMIND_GPIO_ULTRASONIC_ECHO=24
AGRIMIND_ADS1115_CHANNEL=0
AGRIMIND_SOIL_DRY_RAW=28000
AGRIMIND_SOIL_WET_RAW=11000
# Preserved prototype values; physically recalibrate for the actual reservoir.
AGRIMIND_TANK_HEIGHT_CM=30.0
AGRIMIND_TANK_OFFSET_CM=2.0
