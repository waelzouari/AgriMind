{
  "schema_version": 2,
  "training_config_version": "agrimind-cv-mobilenet-v2-training-v1",
  "architecture": "mobilenet_v2",
  "pretrained_weights": "IMAGENET1K_V1",
  "seed": 42,
  "split": {
    "schema_version": 1,
    "contract_version": "agrimind-cv-group-split-v1",
    "strategy": "deterministic_stratified_related-group-hash",
    "train": 0.7,
    "validation": 0.15,
    "test": 0.15
  },
  "preprocessing": {
    "schema_version": 1,
    "contract_version": "agrimind-cv-mobilenet-v2-preprocessing-v1",
    "width": 224,
    "height": 224,
    "color_mode": "RGB",
    "dtype": "float32",
    "layout": "CHW",
    "resize": "fit_center_crop",
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225]
  },
  "augmentation": {
    "schema_version": 1,
    "contract_version": "agrimind-cv-horizontal-flip-v1",
    "horizontal_flip_probability": 0.5,
    "seed_strategy": "sha256(global_seed:epoch:sample_identity)"
  },
  "selection": {
    "schema_version": 1,
    "rule_version": "agrimind-cv-validation-selection-v1",
    "primary_metric": "macro_f1",
    "secondary_metric": "accuracy",
    "tie_preference": "mean_rgb_centroid_baseline"
  },
  "optimizer": "Adam",
  "learning_rate": 0.001,
  "batch_size": 32,
  "epochs": 10,
  "early_stopping_patience": 3
}
