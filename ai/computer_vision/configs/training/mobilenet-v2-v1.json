{
  "schema_version": 1,
  "architecture": "mobilenet_v2",
  "pretrained_weights": "IMAGENET1K_V1",
  "seed": 42,
  "split": {
    "strategy": "deterministic_stratified_exact-duplicate-group_hash",
    "train": 0.7,
    "validation": 0.15,
    "test": 0.15,
    "require_group_ids": false
  },
  "preprocessing": {
    "width": 224,
    "height": 224,
    "color_mode": "RGB",
    "dtype": "float32",
    "layout": "CHW",
    "resize": "fit_center_crop",
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225]
  },
  "augmentation": {"horizontal_flip_probability": 0.5},
  "optimizer": "Adam",
  "learning_rate": 0.001,
  "batch_size": 32,
  "epochs": 10,
  "early_stopping_patience": 3
}
