{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrimind.example/ai/computer-vision/official-evaluation.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "model", "artifact", "dataset", "split", "training",
    "validation", "test", "execution", "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "model": {"$ref": "#/$defs/object"},
    "artifact": {"$ref": "#/$defs/object"},
    "dataset": {"$ref": "#/$defs/object"},
    "split": {"$ref": "#/$defs/object"},
    "training": {"$ref": "#/$defs/object"},
    "validation": {"$ref": "#/$defs/object"},
    "test": {"$ref": "#/$defs/object"},
    "execution": {"$ref": "#/$defs/object"},
    "limitations": {
      "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "object": {"type": "object", "minProperties": 1}
  }
}
