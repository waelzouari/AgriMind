# Trusted server runtime only. Never copy these variables into Flutter or edge.
AGRIMIND_INGESTION_MQTT_HOST=mqtt.example.invalid
AGRIMIND_INGESTION_MQTT_PORT=8883
AGRIMIND_INGESTION_MQTT_CLIENT_ID=agrimind-ingestion-production
AGRIMIND_INGESTION_MQTT_USERNAME=replace-at-deployment
AGRIMIND_INGESTION_MQTT_PASSWORD=replace-at-deployment
AGRIMIND_INGESTION_MQTT_CA_FILE=/etc/ssl/certs/ca-certificates.crt

AGRIMIND_INGESTION_SUPABASE_URL=https://project-ref.supabase.co
AGRIMIND_INGESTION_SUPABASE_SERVICE_ROLE_KEY=replace-in-server-secret-store

# Operational validity limits, not agronomic thresholds.
AGRIMIND_INGESTION_MAXIMUM_AGE_SECONDS=86400
AGRIMIND_INGESTION_MAXIMUM_FUTURE_SKEW_SECONDS=300
# Optional when running outside a repository checkout; deploy the unchanged v1
# schemas from contracts/v1 at this absolute directory.
# AGRIMIND_INGESTION_CONTRACT_ROOT=/etc/agrimind/contracts/v1
