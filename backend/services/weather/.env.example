# AGM-019 trusted server runtime. Store the real service role only in the
# deployment secret store; never copy it to Flutter or edge configuration.
AGRIMIND_WEATHER_SUPABASE_URL=https://project-ref.supabase.co
AGRIMIND_WEATHER_SUPABASE_SERVICE_ROLE_KEY=replace-in-server-secret-store

AGRIMIND_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
AGRIMIND_WEATHER_HTTP_TIMEOUT_SECONDS=5
AGRIMIND_WEATHER_FRESH_TTL_SECONDS=1800
AGRIMIND_WEATHER_MAX_STALE_SECONDS=21600
AGRIMIND_WEATHER_REFRESH_INTERVAL_SECONDS=900
