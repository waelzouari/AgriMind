{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrimind.example/contracts/v1/pump-command.schema.json",
  "title": "AgriMind v1 pump command",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "farm_id", "device_id", "action", "issued_at", "expires_at", "requested_by"],
  "properties": {
    "schema_version": {"const": 1},
    "command_id": {"type": "string", "format": "uuid"},
    "farm_id": {"type": "string", "format": "uuid"},
    "device_id": {"type": "string", "format": "uuid"},
    "action": {"enum": ["on", "off"]},
    "issued_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "requested_by": {"type": "string", "format": "uuid"},
    "duration_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
  },
  "allOf": [
    {"if": {"properties": {"action": {"const": "on"}}}, "then": {"required": ["duration_seconds"]}},
    {"if": {"properties": {"action": {"const": "off"}}}, "then": {"not": {"required": ["duration_seconds"]}}}
  ]
}
